class Board {
    field int rows, cols;
    field Array grid;
    field int safeCellsRemaining;

    constructor Board new(int r, int c) {
        var int x, y;
        var Array currentColumn;
        let rows = r; let cols = c;
        let grid = Array.new(cols);
        let x = 0;
        while (x < cols) {
            let currentColumn = Array.new(rows);
            let grid[x] = currentColumn;
            let y = 0;
            while (y < rows) {
                let currentColumn[y] = Square.new();
                let y = y + 1;
            }
            let x = x + 1;
        }
        return this;
    }

    method void dispose() {
        var int x, y; var Array currentColumn; var Square sq;
        let x = 0;
        while (x < cols) {
            let currentColumn = grid[x]; let y = 0;
            while (y < rows) {
                let sq = currentColumn[y]; do sq.dispose();
                let y = y + 1;
            }
            do Memory.deAlloc(currentColumn); let x = x + 1;
        }
        do Memory.deAlloc(grid); do Memory.deAlloc(this);
        return;
    }

    method void deployMines(int totalMines) {
        var int placed, rx, ry; var Array column; var Square sq;
        let placed = 0;
        while (placed < totalMines) {
            let rx = Random.randRange(cols);
            let ry = Random.randRange(rows);
            let column = grid[rx]; let sq = column[ry];
            if (~sq.hasMine()) {
                do sq.setMine();
                let placed = placed + 1;
            }
        }
        do calculateNumbers();
        return;
    }

    method int checkMine(int cx, int cy) {
        var Array column; var Square sq;
        if (cx < 0) { return 0; } if (cx > (cols - 1)) { return 0; }
        if (cy < 0) { return 0; } if (cy > (rows - 1)) { return 0; }
        let column = grid[cx]; let sq = column[cy];
        if (sq.hasMine()) { return 1; }
        return 0;
    }

    method void calculateNumbers() {
        var int x, y, count; var Array column; var Square sq;
        let x = 0;
        while (x < cols) {
            let y = 0;
            while (y < rows) {
                let column = grid[x]; let sq = column[y];
                if (~sq.hasMine()) {
                    let count = 0;
                    let count = count + checkMine(x - 1, y - 1); let count = count + checkMine(x, y - 1); let count = count + checkMine(x + 1, y - 1);
                    let count = count + checkMine(x - 1, y);                                              let count = count + checkMine(x + 1, y);
                    let count = count + checkMine(x - 1, y + 1); let count = count + checkMine(x, y + 1); let count = count + checkMine(x + 1, y + 1);
                    do sq.setAdjacentMines(count);
                }
                let y = y + 1;
            }
            let x = x + 1;
        }
        return;
    }

    method boolean isRevealed(int cx, int cy) {
        var Array column; var Square sq;
        let column = grid[cx]; let sq = column[cy];
        return sq.getRevealed();
    }

    method void drawCell(int cx, int cy) {
        var Array column; var Square sq; var int px, py, count, row, col;
        let column = grid[cx]; let sq = column[cy];
        let px = 10 + (cx * 16); let py = 10 + (cy * 16);

        do Screen.setColor(false);
        do Screen.drawRectangle(px + 1, py + 1, px + 15, py + 15);

        if (sq.getRevealed()) {
            if (sq.hasMine()) {
                do Screen.setColor(true); do Screen.drawCircle(px + 8, py + 8, 5);
            } else {
                let count = sq.getAdjacentMines();
                if (count > 0) {
                    if (cy = 0) { do Output.moveCursor(1, 2 + (cx * 2)); }
                    if (cy = 1) { do Output.moveCursor(3, 2 + (cx * 2)); }
                    if (cy = 2) { do Output.moveCursor(4, 2 + (cx * 2)); }
                    if (cy = 3) { do Output.moveCursor(6, 2 + (cx * 2)); }
                    if (cy = 4) { do Output.moveCursor(7, 2 + (cx * 2)); }
                    if (cy = 5) { do Output.moveCursor(8, 2 + (cx * 2)); }
                    if (cy = 6) { do Output.moveCursor(10, 2 + (cx * 2)); }
                    if (cy = 7) { do Output.moveCursor(11, 2 + (cx * 2)); }
                    if (cy = 8) { do Output.moveCursor(13, 2 + (cx * 2)); }
                    if (cy = 9) { do Output.moveCursor(14, 2 + (cx * 2)); }
                    
                    do Output.printInt(count);
                }
            }
        } else {
            do Screen.setColor(true);
            do Screen.drawRectangle(px + 3, py + 3, px + 13, py + 13);
            
            if (sq.getFlagged()) {
                do Screen.setColor(false);
                do Screen.drawLine(px + 4, py + 4, px + 12, py + 12);
                do Screen.drawLine(px + 4, py + 12, px + 12, py + 4);
            }
        }
        return;
    }

    method void draw() {
        var int i, j, x, y;
        do Screen.setColor(true);
        let i = 0; while (i < (cols + 1)) { let x = 10 + (i * 16); do Screen.drawLine(x, 10, x, 10 + (rows * 16)); let i = i + 1; }
        let i = 0; while (i < (rows + 1)) { let y = 10 + (i * 16); do Screen.drawLine(10, y, 10 + (cols * 16), y); let i = i + 1; }
        
        let i = 0;
        while (i < cols) {
            let j = 0;
            while (j < rows) {
                do drawCell(i, j);
                let j = j + 1;
            }
            let i = i + 1;
        }
        
        do Output.moveCursor(2, 30); do Output.printString("MINESWEEPER");
        do Output.moveCursor(4, 30); do Output.printString("Arrows: Move");
        do Output.moveCursor(6, 30); do Output.printString("Space: Reveal");
        do Output.moveCursor(8, 30); do Output.printString("F: Flag");
        do Output.moveCursor(10, 30); do Output.printString("Q: Quit");
        return;
    }

    method int reveal(int cx, int cy) {
        var Array column; var Square sq; var int count;
        if (cx < 0) { return 0; } if (cx > (cols - 1)) { return 0; }
        if (cy < 0) { return 0; } if (cy > (rows - 1)) { return 0; }

        let column = grid[cx]; let sq = column[cy];
        if (sq.getRevealed()) { return 0; }
        if (sq.getFlagged()) { return 0; }

        do sq.setRevealed();
        do drawCell(cx, cy);

        if (sq.hasMine()) {
            return 2;
        }

        let safeCellsRemaining = safeCellsRemaining - 1;
        
        if (safeCellsRemaining = 0) {
            return 1;
        }

        let count = sq.getAdjacentMines();
        if (count = 0) {
            do reveal(cx - 1, cy - 1); do reveal(cx, cy - 1); do reveal(cx + 1, cy - 1);
            do reveal(cx - 1, cy);                            do reveal(cx + 1, cy);
            do reveal(cx - 1, cy + 1); do reveal(cx, cy + 1); do reveal(cx + 1, cy + 1);
        }
        
        return 0;
    }

    method void toggleFlag(int cx, int cy) {
        var Array column; var Square sq;
        if (cx < 0) { return; } if (cx > (cols - 1)) { return; }
        if (cy < 0) { return; } if (cy > (rows - 1)) { return; }
        let column = grid[cx]; let sq = column[cy];
        if (sq.getRevealed()) { return; }

        do sq.toggleFlag();
        do drawCell(cx, cy);
        return;
    }
}